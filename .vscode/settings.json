{
   "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/.dart_tool": true,
      "**/.idea": true,
      "**/build": true,
      "**/target": true
   },
   "search.exclude": {
      "**/.git": true,
      "**/.dart_tool": true,
      "**/.idea": true,
      "**/build": true,
      "**/target": true,
      "**/node_modules": true
   },
   "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/.dart_tool/**": true,
      "**/.idea/**": true,
      "**/build/**": true,
      "**/target/**": true,
      "**/node_modules/**": true
   },
   "java.compile.nullAnalysis.mode": "automatic",
   "cSpell.words": ["cupertino", "devkey", "hugeicons", "ILIKE", "LIVEKIT", "omnicaller"],
   "java.configuration.updateBuildConfiguration": "interactive"
}
