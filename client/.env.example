# OmniCaller Client - Environment Configuration
# Copy this file to .env and update with your values

# ════════════════════════════════════════════════════════════════
# ENVIRONMENT MODE
# ════════════════════════════════════════════════════════════════
# Options: local, staging, production
ENV_MODE=production

# ════════════════════════════════════════════════════════════════
# CLOUDFLARE PRODUCTION URLs
# ════════════════════════════════════════════════════════════════
# Replace with your actual Cloudflare domain
API_BASE_URL=https://api.your-domain.com
LIVEKIT_URL=wss://livekit.your-domain.com

# ════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT (Optional - for testing without Cloudflare)
# ════════════════════════════════════════════════════════════════
# Uncomment and use these for local development
# ENV_MODE=local
# API_HOST=192.168.1.162
# API_PORT=3000
# API_BASE_URL=http://192.168.1.162:3000
# LIVEKIT_URL=ws://192.168.1.162:7880

# ════════════════════════════════════════════════════════════════
# STAGING (Optional)
# ════════════════════════════════════════════════════════════════
# ENV_MODE=staging
# API_BASE_URL=https://api-staging.your-domain.com
# LIVEKIT_URL=wss://livekit-staging.your-domain.com

# ════════════════════════════════════════════════════════════════
# HOW TO USE
# ════════════════════════════════════════════════════════════════
# 
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Update URLs with your Cloudflare domain
#
# 3. Run with dart-define:
#    flutter run --dart-define-from-file=.env
#
# 4. Or build release:
#    flutter build apk --dart-define-from-file=.env
#    flutter build ios --dart-define-from-file=.env
#
# ════════════════════════════════════════════════════════════════
